# ImgLab Tools – Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./data/imglab.db

# Security
ENABLE_HELMET=true
ENABLE_CORS=true

# API
API_RATE_LIMIT=100
API_RATE_WINDOW=15

# Analytics
ENABLE_ANALYTICS=true
CLEANUP_DAYS=30

# Logging
LOG_LEVEL=info
